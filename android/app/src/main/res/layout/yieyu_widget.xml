<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/yieyu_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/yieyu_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/yieyu_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Yieyu 音乐"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/yieyu_widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="未在播放"
        android:textColor="#FF8F97AA"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/yieyu_widget_spectrum"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/yieyu_widget_spectrum"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/yieyu_widget_prev"
            android:layout_width="42dp"
            android:layout_height="24dp"
            android:background="@drawable/yieyu_widget_btn"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="◀"
            android:textColor="#FFD6DAE6"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/yieyu_widget_play"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/yieyu_widget_btn_accent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#FF10131A"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/yieyu_widget_next"
            android:layout_width="42dp"
            android:layout_height="24dp"
            android:background="@drawable/yieyu_widget_btn"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▶"
            android:textColor="#FFD6DAE6"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
